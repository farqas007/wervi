# ─────────────────────────────────────────────────────────────────────────────
# WERVI — environment template
# Copy to `.env` (repo root) for local development. Never commit real values.
#   cp .env.example .env
# All variables are validated at boot by apps/api/src/config/env.ts — the API
# refuses to start on invalid configuration rather than failing at first use.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Development: Neon free tier. Copy the pooled connection string from the Neon
# console and make sure it ends with ?sslmode=require
# Production:  your managed Postgres instance, same shape.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Set to "require" for any hosted provider (Neon, Supabase, RDS). Use "disable"
# only for a local socket / trusted network.
DATABASE_SSL=require
# Hard cap on pooled connections. Neon free tier pooled endpoints allow ~10.
DATABASE_POOL_MAX=10
# Statement timeout in milliseconds. Protects the pool from runaway queries.
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Database dedicated to running integration tests and `pnpm db:seed`.
# Must be a *separate* database from DATABASE_URL: the suites truncate every
# table between tests, and the seed truncates before it inserts.
#   - `pnpm test` uses it when set. If unset, the suites fall back to
#     DATABASE_URL only when its name contains "test", and otherwise skip.
#   - `pnpm db:seed` *requires* it and never falls back to DATABASE_URL. Its
#     name must also contain "test", or the seed refuses to run. Point this at a
#     database you are happy to see emptied, never at a development one.
# Leave unset for normal development — the API only needs DATABASE_URL.
# DATABASE_TEST_URL=postgresql://USER:PASSWORD@HOST/wervi_test?sslmode=require

# ── API server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
# Public origin of the API. Used for OpenAPI docs and CORS defaults.
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Public documentation routes. Disable in production if you want a private API.
API_EXPOSE_DOCS=true
# error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Web (Next.js) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Coming in later phases (leave unset for now) ─────────────────────────────
# REDIS_URL=
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

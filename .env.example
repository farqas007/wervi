# ─────────────────────────────────────────────────────────────────────────────
# WERVI — environment template
# Copy to `.env` (repo root) for local development. Never commit real values.
#   cp .env.example .env
# All variables are validated at boot by apps/api/src/config/env.ts — the API
# refuses to start on invalid configuration rather than failing at first use.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Development: Neon free tier. Copy the pooled connection string from the Neon
# console and make sure it ends with ?sslmode=require
# Production:  your managed Postgres instance, same shape.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Set to "require" for any hosted provider (Neon, Supabase, RDS). Use "disable"
# only for a local socket / trusted network.
DATABASE_SSL=require
# Hard cap on pooled connections. Neon free tier pooled endpoints allow ~10.
DATABASE_POOL_MAX=10
# Statement timeout in milliseconds. Protects the pool from runaway queries.
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Database dedicated to running integration tests and `pnpm db:seed`.
# Must be a *separate* database from DATABASE_URL: the suites truncate every
# table between tests, and the seed truncates before it inserts.
#   - `pnpm test` uses it when set. If unset, the suites fall back to
#     DATABASE_URL only when its name contains "test", and otherwise skip.
#   - `pnpm db:seed` *requires* it and never falls back to DATABASE_URL. Its
#     name must also contain "test", or the seed refuses to run. Point this at a
#     database you are happy to see emptied, never at a development one.
# Leave unset for normal development — the API only needs DATABASE_URL.
# DATABASE_TEST_URL=postgresql://USER:PASSWORD@HOST/wervi_test?sslmode=require

# ── API server ───────────────────────────────────────────────────────────────
# Bind all interfaces so the host/container network (Render, Docker) can reach
# the server. Do not set this to 127.0.0.1 in production.
API_HOST=0.0.0.0
# Hosting platforms (Render, Heroku, Fly.io) inject `PORT`, which takes
# precedence over API_PORT. Leave API_PORT at 4000 for local development; it is
# only used when the platform does not set PORT.
API_PORT=4000
# Public origin of the API. Used for OpenAPI docs and CORS defaults.
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Public documentation routes. Disable in production if you want a private API.
API_EXPOSE_DOCS=true
# error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Web (Next.js) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# Session signing key. Required in production; generate one with
# `openssl rand -base64 32`. In development Better Auth falls back to a
# per-process random key when unset (sessions do not survive restarts).
# BETTER_AUTH_SECRET=
# Public origin of the auth routes; defaults to API_BASE_URL when unset.
# BETTER_AUTH_URL=http://localhost:4000
# Comma-separated extra origins allowed to receive auth cookies.
# BETTER_AUTH_TRUSTED_ORIGINS=
# SameSite policy for session cookies: `lax` (default) or `none`. `none` is
# only needed when the web app and API are on different *sites* (e.g. sibling
# *.onrender.com services), where the browser would drop Lax cookies on
# cross-site credentialed fetches. Keep `lax` when they share a domain.
# BETTER_AUTH_COOKIE_SAME_SITE=lax

# ── Coming in later phases (leave unset for now) ─────────────────────────────
# REDIS_URL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

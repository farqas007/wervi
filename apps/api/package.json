{
  "name": "@wervi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WERVI REST API and background workers",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@wervi/db": "workspace:*",
    "@wervi/shared": "workspace:*",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
